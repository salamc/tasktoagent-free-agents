# Your mailbox
IMAP_HOST=
# Your mailbox
IMAP_USER=
# Your mailbox
IMAP_PASSWORD=
# How far back to look, default 30
DAYS=
# Subject/file words that mean 'invoice', default invoice,receipt,facture,rechnung,order confirmation...
KEYWORDS=
