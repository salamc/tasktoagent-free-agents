# From your app at dev.twitch.tv/console
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Comma-separated channel names (twitch.tv/name), any number
CHANNELS=
# Where alerts go (channel settings, then Integrations, then Webhooks)
DISCORD_WEBHOOK_URL=
# Optional: ping only this role; @everyone in stream titles never pings
DISCORD_ROLE_ID=
# Optional: only announce streams in these games, e.g. Valorant,Minecraft
GAMES=
# Optional: also post to Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: also post to Slack
SLACK_WEBHOOK_URL=
# Default twitch_live_state.json (keep it between runs)
STATE_FILE=
