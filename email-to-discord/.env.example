# One inbox (default folder INBOX)
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=
# Optional: your Discord webhook
DISCORD_WEBHOOK_URL=
# Optional: Telegram bot token from @BotFather and the chat, group or channel id (or @channelname)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: Slack incoming webhook URL
SLACK_WEBHOOK_URL=
# Optional comma-separated filters
FROM_CONTAINS=
SUBJECT_CONTAINS=
EXCLUDE=
# Several inboxes: a JSON file like inboxes.example.json (own filters and destinations each)
INBOXES_FILE=
# Defaults 20 / 300
MAX_PER_RUN=
PREVIEW_CHARS=
