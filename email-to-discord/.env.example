# One inbox (default folder INBOX)
IMAP_HOST=
# One inbox (default folder INBOX)
IMAP_USER=
# One inbox (default folder INBOX)
IMAP_PASSWORD=
# One inbox (default folder INBOX)
IMAP_FOLDER=
# Your Discord webhook
DISCORD_WEBHOOK_URL=
# Optional comma-separated filters
FROM_CONTAINS=
# Optional comma-separated filters
SUBJECT_CONTAINS=
# Optional comma-separated filters
EXCLUDE=
# Several inboxes: a JSON file like inboxes.example.json (own filters + webhook each)
INBOXES_FILE=
# Defaults 20 / 300
MAX_PER_RUN=
# Defaults 20 / 300
PREVIEW_CHARS=
