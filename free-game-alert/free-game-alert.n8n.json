      "name": "Epic free games",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(i => ({ json: { id: 'gp:' + i.json.id, title: i.json.title, url: i.json.open_giveaway_url, note: `FREE (worth ${i.json.worth}) on ${i.json.platforms}, ends ${i.json.end_date}` } }));"
      },
      "id": "cfb1a83c-0faa-5632-97f0-829a7b4ce710",
      "name": "Format GamerPower",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        -100
      ]
    },
    {
      "parameters": {
        "jsCode": "const now = new Date(); const out = [];\nfor (const g of $json.data.Catalog.searchStore.elements) {\n  for (const b of (g.promotions?.promotionalOffers || [])) for (const o of b.promotionalOffers) {\n    if (new Date(o.startDate) <= now && now <= new Date(o.endDate) && o.discountSetting?.discountPercentage === 0) {\n      const slug = g.productSlug || g.catalogNs?.mappings?.[0]?.pageSlug || '';\n      out.push({ json: { id: 'epic:' + g.id, title: g.title, url: slug ? `https://store.epicgames.com/p/${slug}` : 'https://store.epicgames.com/free-games', note: `FREE on Epic until ${o.endDate}` } });\n    }\n  }\n}\nreturn out;"
      },
      "id": "fbd881c8-2ea4-5fd3-8500-b9e6d15beeca",
