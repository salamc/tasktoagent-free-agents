# Your Discord webhook URL (leave all destinations empty to just print)
DISCORD_WEBHOOK_URL=
# Optional: Telegram bot token from @BotFather and the chat, group or channel ID (or @channelname)
TELEGRAM_BOT_TOKEN=
# Optional: Telegram bot token from @BotFather and the chat, group or channel ID (or @channelname)
TELEGRAM_CHAT_ID=
# Optional: Slack incoming webhook URL
SLACK_WEBHOOK_URL=
# pc, steam, epic-games-store, gog, itchio... default pc
GAMERPOWER_PLATFORMS=
# Store country, default US
COUNTRY=
# Optional IsThereAnyDeal key
ITAD_API_KEY=
# Optional, comma-separated titles to price-watch, e.g. Hades II,Balatro
WATCH_GAMES=
# Alert when a watched game is at or below this price, default 10
MAX_PRICE=
