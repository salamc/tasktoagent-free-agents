    {
      "parameters": {
        "jsCode": "// A sent email is 'unanswered' if nobody wrote in the same thread after it.\nconst skip = /(no-?reply|notifications?@|mailer-daemon|calendar)/i;\nconst received = $('Received mail').all().map(i => i.json);\nconst lastReply = {};\nfor (const r of received) lastReply[r.threadId] = Math.max(lastReply[r.threadId] || 0, Number(r.internalDate));\nconst latest = {};\nfor (const s of $('Sent mail').all().map(i => i.json)) {\n  if (!latest[s.threadId] || Number(s.internalDate) > Number(latest[s.threadId].internalDate)) latest[s.threadId] = s;\n}\nconst open = Object.values(latest).filter(s => !(lastReply[s.threadId] > Number(s.internalDate)) && !skip.test(s.To || ''));\nconst days = s => Math.floor((Date.now() - Number(s.internalDate)) / 864e5);\nopen.sort((a, b) => Number(a.internalDate) - Number(b.internalDate));\nconst text = open.length\n  ? `${open.length} sent email(s) with no reply after 3+ days:\\n\\n` + open.map(s => `- ${days(s)}d ago -> ${s.To}\\n  ${s.Subject}`).join('\\n') + '\\n\\nNothing was sent to anyone.'\n  : 'No unanswered emails older than 3 days.';\nreturn [{ json: { count: open.length, text } }];"
      },
      "id": "7278de38-32c7-565c-b4ca-c9fc846640b2",
      "name": "Find unanswered",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
