# e.g. imap.gmail.com / you@gmail.com / your app password
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
# No reply after this many days, default 3
DAYS=
# Ignore sent mail older than this, default 21
LOOKBACK_DAYS=
# Auto-detected (e.g. [Gmail]/Sent Mail); set it if detection fails
SENT_FOLDER=
# Where replies land, default INBOX (Gmail: add [Gmail]/All Mail if you archive)
REPLY_FOLDERS=
# Your addresses/aliases, comma-separated (default IMAP_USER)
MY_ADDRESSES=
# Optional: email the list to yourself (reuses your IMAP login)
SMTP_HOST=
SMTP_PORT=
EMAIL_TO=
