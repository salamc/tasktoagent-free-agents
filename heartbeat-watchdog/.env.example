# Your heartbeats, default checks.json (copy checks.example.json): file, ping, n8n or url, each with a max_age like 15m, 2h, 26h
CHECKS_FILE=
# Where alerts go
DISCORD_WEBHOOK_URL=
# Optional: alerts by email
EMAIL_TO=
# Optional: alerts by email
SMTP_HOST=
# Optional: alerts by email
SMTP_PORT=
# Optional: alerts by email
SMTP_USER=
# Optional: alerts by email
SMTP_PASSWORD=
# Optional: for n8n heartbeats, e.g. http://localhost:5678
N8N_URL=
# Optional: for n8n heartbeats, e.g. http://localhost:5678
N8N_API_KEY=
# serve mode: ping receiver port (default 8765) and an optional secret ?token=
PORT=
# serve mode: ping receiver port (default 8765) and an optional secret ?token=
PING_TOKEN=
