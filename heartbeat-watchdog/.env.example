# Your heartbeats, default checks.json (copy checks.example.json): file, ping, n8n or url, each with a max_age like 15m, 2h, 26h. Optional: min_size for files ("1MB"; the target can be a pattern like /backups/*.sql.gz, newest file counts) and min_count for pings (jobs call /ping/name?count=12, or /ping/name/fail for a failed run)
CHECKS_FILE=
# Where alerts go
DISCORD_WEBHOOK_URL=
# Optional: alerts by email
EMAIL_TO=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# Optional: for n8n heartbeats, e.g. http://localhost:5678
N8N_URL=
N8N_API_KEY=
# serve mode: ping receiver port (default 8765) and an optional secret ?token=
PORT=
PING_TOKEN=
