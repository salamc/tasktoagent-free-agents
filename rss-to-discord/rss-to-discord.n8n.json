{
  "name": "TaskToAgent - RSS to Discord",
  "nodes": [
    {
      "parameters": {
        "content": "## RSS to Discord\nEvery 15 min: new feed items matching your keywords go to a Discord channel.\n\n1. Edit **Feed list** and **Keyword filter**.\n2. Paste your Discord webhook URL into **Post to Discord**.\n3. Tip: run once manually with Post to Discord disabled so old posts are remembered, then enable & activate.",
        "height": 300,
        "width": 420
      },
      "id": "a35f5e0b-0e7a-51ed-9350-632e1899d64f",
      "name": "Read me",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -460,
        -260
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "b24a015f-9349-5759-9a5e-97c346f9c00d",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Edit your feeds here\nconst feeds = [\n \"https://hnrss.org/frontpage\",\n \"https://www.rockpapershotgun.com/feed\"\n];\nreturn feeds.map(url => ({ json: { url } }));"
      },
      "id": "82da1579-2e02-5196-9528-814f2f34f7e6",
      "name": "Feed list",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.url }}",
        "options": {
          "ignoreSSL": false
        }
      },
      "id": "c56097c8-f124-57de-8d6e-225a231daec3",
      "name": "Read RSS",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1.1,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Leave empty to post everything\nconst keywords = ['ai', 'game'];\nreturn $input.all().filter(i => !keywords.length || keywords.some(k => `${i.json.title} ${i.json.contentSnippet||''}`.toLowerCase().includes(k)));"
      },
      "id": "665fc1a3-b91e-5f0e-98fe-c93c4205bcfb",
      "name": "Keyword filter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "operation": "removeItemsSeenInPreviousExecutions",
        "logic": "removeItemsWithAlreadySeenKeyValues",
        "dedupeValue": "={{ $json.link }}",
        "options": {}
      },
      "id": "79ff30c5-8ee1-5579-88b1-22cbb3bea879",
      "name": "Only new",
      "type": "n8n-nodes-base.removeDuplicates",
      "typeVersion": 2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "PASTE_YOUR_DISCORD_WEBHOOK_URL",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ username: \"RSS Bot\", content: \"**\" + $json.title + \"**\\n\" + $json.link }) }}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 1000
            }
          }
        }
      },
      "id": "41d8dcae-f787-50d1-b23e-3e19d2d91255",
      "name": "Post to Discord",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        0
      ]
    }
  ],
