# Comma-separated feed URLs (YouTube: https://www.youtube.com/feeds/videos.xml?channel_id=...)
FEEDS=
# Comma-separated, case-insensitive; empty = everything
KEYWORDS=
# Your Discord webhook (optional if you use Telegram or Slack)
DISCORD_WEBHOOK_URL=
# Optional: Telegram bot token from @BotFather and the chat, group or channel ID (or @channelname) to post to
TELEGRAM_BOT_TOKEN=
# Optional: Telegram bot token from @BotFather and the chat, group or channel ID (or @channelname) to post to
TELEGRAM_CHAT_ID=
# Optional: Slack incoming webhook URL
SLACK_WEBHOOK_URL=
# Cap per run, default 10
MAX_PER_RUN=
