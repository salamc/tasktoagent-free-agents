# Comma-separated feed URLs (YouTube: https://www.youtube.com/feeds/videos.xml?channel_id=...)
FEEDS=
# Comma-separated, case-insensitive; empty = everything
KEYWORDS=
# Optional: skip items whose title or link contains any of these, e.g. -rc,beta,alpha
EXCLUDE=
# Optional: 1 = match KEYWORDS in the title only (Reddit search feeds match the post text too)
TITLE_ONLY=
# Seconds between feeds, default 3 (Reddit answers 429 to fast back-to-back requests)
FEED_PAUSE=
# Your Discord webhook (optional if you use Telegram or Slack)
DISCORD_WEBHOOK_URL=
# Optional: Telegram bot token from @BotFather and the chat, group or channel ID (or @channelname) to post to
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: Slack incoming webhook URL
SLACK_WEBHOOK_URL=
# Cap per run, default 10
MAX_PER_RUN=
