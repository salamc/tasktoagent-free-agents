# Your pages, default watches.json (copy watches.example.json): url, name, and optionally appears / disappears (a phrase), start / end (only watch the text between two phrases) and ignore (a regex for dates or counters)
WATCHES_FILE=
# Or watch a single page without a file
WATCH_URL=
WATCH_APPEARS=
WATCH_DISAPPEARS=
WATCH_IGNORE=
# Your Discord webhook (leave every destination empty to just print)
DISCORD_WEBHOOK_URL=
# Optional: Telegram bot token from @BotFather and the chat, group or channel ID (or @channelname)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: Slack incoming webhook URL
SLACK_WEBHOOK_URL=
# Optional: email the alerts
EMAIL_TO=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# Tell you once when a page can't be loaded this many checks in a row, default 3
FAIL_ALERT_AFTER=
# Default website_change_state.json (keep it between runs)
STATE_FILE=
