# e.g. imap.gmail.com / you@gmail.com / your app password
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
# Default INBOX
IMAP_FOLDER=
# Default 24
HOURS=
# Optional: comma-separated addresses or @domains always treated as people, e.g. @myclient.com
PEOPLE=
# Optional: addresses or @domains always treated as newsletters
BULK=
# Optional: email the summary (reuses your IMAP login by default)
SMTP_HOST=
EMAIL_TO=
# Optional AI summary (only emails from people are sent, newsletters are just counted)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
