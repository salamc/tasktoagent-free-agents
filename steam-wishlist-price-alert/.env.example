# Your 17-digit SteamID64 (wishlist must be public); or use WATCH_GAMES
STEAM_ID=
# Comma-separated titles or Steam app ids, e.g. Balatro,Hades II,1030300
WATCH_GAMES=
# Alert at or below this price, default 10
TARGET_PRICE=
# ...or at least this % off, default 50
MIN_DISCOUNT=
# Alert when cheaper than last check, default 1
ALERT_NEW_LOW=
# Steam store country, default us
COUNTRY=
# Your Discord webhook (leave every destination empty to just print)
DISCORD_WEBHOOK_URL=
# Optional: Telegram bot token from @BotFather and the chat, group or channel ID (or @channelname)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: Slack incoming webhook URL
SLACK_WEBHOOK_URL=
# Optional: email the alerts instead or as well
EMAIL_TO=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
